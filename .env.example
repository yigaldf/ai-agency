# Postgres. Railway injects this automatically when you add a Postgres service and reference it.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agency

# Required for the morning feedback and the mental coach
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended: protects the dashboard with HTTP Basic Auth (any username)
DASHBOARD_PASSWORD=

# Optional
CLAUDE_MODEL=claude-opus-5-5
