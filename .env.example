# Postgres. Railway injects this automatically when you add a Postgres service and reference it.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agency

# Required for the morning feedback and the mental coach
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended: protects the dashboard with HTTP Basic Auth (any username)
DASHBOARD_PASSWORD=

# Optional
CLAUDE_MODEL=claude-opus-5-5

# Google Calendar via OAuth (preferred; reuse Roger's OAuth client, add this app's
# callback URL https://<your-domain>/oauth/google/callback to it in Google Cloud → Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this app (used to build the OAuth callback). Optional: derived from the request if empty.
PUBLIC_BASE_URL=

# Fallback: Google Calendar feed for the routines tab.
# Google Calendar → Settings → your calendar → "Secret address in iCal format"
CALENDAR_ICS_URL=
CALENDAR_TZ=Asia/Jerusalem
